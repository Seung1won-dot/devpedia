{
  "name": "devpedia",
  "version": "0.1.0",
  "description": "카테고리별 IT 용어 사전 — 한 줄 정의·비유·예시·관련 용어",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "tsx scripts/build-terms.ts --lenient && vite --host",
    "build": "tsx scripts/build-terms.ts && vite build",
    "preview": "vite preview --host",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.scripts.json",
    "validate": "tsx scripts/validate.ts",
    "check:cards": "tsx scripts/check-cards.ts",
    "build:terms": "tsx scripts/build-terms.ts",
    "new": "tsx scripts/new-term.ts",
    "icons": "node scripts/make-icons.mjs",
    "check": "npm run validate && npm run typecheck && npm run test && npm run build"
  },
  "keywords": [
    "glossary",
    "pwa",
    "korean",
    "it-terms",
    "vite",
    "react"
  ],
  "author": "Seung1_dot (ECLAB)",
  "license": "MIT",
  "dependencies": {
    "minisearch": "^7.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "fast-glob": "^3.3.3",
    "gray-matter": "^4.0.3",
    "jsdom": "^30.1.1",
    "marked": "^18.0.14",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  }
}
